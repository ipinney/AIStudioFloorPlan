# Copy to .env.local. Only the API server reads these; nothing reaches the browser.

# Claude runs the architect interview, reads the plan, and writes image prompts.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ComfyUI on the spark box (Qwen-Image 2512 + Qwen-Image-Edit 2511, Lightning LoRAs).
# On spark itself the default works. From elsewhere, point it at a tunnel, e.g.
#   ssh -N -L 8188:127.0.0.1:8188 eliot@spark-2f53
COMFY_URL=http://127.0.0.1:8188
# Same machine as ComfyUI? Point at its folder so job uploads/outputs are deleted after use.
# COMFY_DIR=/home/eliot/ComfyUI
# COMFY_TIMEOUT_MS=900000

# Blender for geometry renders (Cycles). Without it, scenes fall back to text-to-image.
# BLENDER_BIN=blender

# API server
# PORT=8790
# HOST=127.0.0.1
